{
  "name": "idf-v-hamas",
  "version": "1.0.0",
  "description": "IDF v Hamas: a first-person shooter for desktop browsers, built with Babylon.js",
  "author": "Richard Catto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rrcatto/IDFvHamas.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/browser/smoke.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@babylonjs/core": "~9.28.0",
    "@babylonjs/havok": "^1.3.10",
    "@babylonjs/loaders": "~9.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
